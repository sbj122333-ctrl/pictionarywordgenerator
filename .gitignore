# NOT ignored, and must stay that way:
#   data/ordinals.lock.json   — the frozen ordinal registry. Losing it breaks
#                               every device's word history irrecoverably.
#   data/words.seed.json      — corpus source of truth
#   public/corpus/*.json      — generated, but committed so the app builds
#                               without a Python toolchain in CI

# The Claude desktop app drops files it delivers into the connected folder.
# They are session artefacts, not part of the site.
Claude outputs/
