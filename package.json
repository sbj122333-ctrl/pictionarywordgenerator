{
  "name": "drawn-and-quartered",
  "version": "1.0.0-alpha",
  "private": true,
  "type": "module",
  "description": "A Pictionary word generator that remembers what it has already shown you.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-manifest.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:property": "vitest run tests/property",
    "lint": "eslint src tests --max-warnings 0",
    "icons": "node scripts/build-icons.mjs",
    "corpus": "node scripts/run-python.mjs scripts/build_corpus.py && node scripts/build-manifest.mjs",
    "corpus:check": "node scripts/run-python.mjs scripts/build_corpus.py --check && node scripts/build-manifest.mjs --check",
    "size": "node scripts/check-size.mjs",
    "ci": "npm run corpus:check && npm run lint && npm run build && npm test && npm run size"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
